// Connector status and EDID describe the panel, not the Wayland socket.
import std.core;
import std.fs;
import std.os;
import text;
import dir_entries;
import display_live;
import android;

pub struct Monitor {
    name: String,
    width: u64,
    height: u64,
    hz: u64,
    diagonal: u64,
}

fn blank() Monitor {
    Monitor { name: String.new(), width: 0, height: 0, hz: 0, diagonal: 0 }
}

unsafe fn read_byte(raw: *u8, index: usize) u64 {
    var n: u8 = 0;
    unsafe { n = *(raw + index); }
    n as u64
}

fn hex_digit(n: u64) String {
    text.byte_slice("0123456789ABCDEF", n as usize, (n + 1) as usize)
}

unsafe fn edid_code(raw: *u8) String {
    const manufacturer: u64 = (read_byte(raw, 8) << 8) | read_byte(raw, 9);
    const alphabet: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const a: u64 = (manufacturer >> 10) & 31;
    const b: u64 = (manufacturer >> 5) & 31;
    const c: u64 = manufacturer & 31;
    if (a < 1 || a > 26 || b < 1 || b > 26 || c < 1 || c > 26) { ret String.new(); }
    var code: String = text.byte_slice(alphabet, (a - 1) as usize, a as usize);
    const second: String = text.byte_slice(alphabet, (b - 1) as usize, b as usize);
    const third: String = text.byte_slice(alphabet, (c - 1) as usize, c as usize);
    code = code.push_str(second.as_str());
    code = code.push_str(third.as_str());
    const product: u64 = read_byte(raw, 10) | (read_byte(raw, 11) << 8);
    const d0 = hex_digit((product >> 12) & 15);
    const d1 = hex_digit((product >> 8) & 15);
    const d2 = hex_digit((product >> 4) & 15);
    const d3 = hex_digit(product & 15);
    code = code.push_str(d0.as_str());
    code = code.push_str(d1.as_str());
    code = code.push_str(d2.as_str());
    code.push_str(d3.as_str())
}

fn integer_sqrt(n: u64) u64 {
    if (n == 0) { ret 0; }
    var x: u64 = n;
    var y: u64 = (x + 1) / 2;
    for (y < x) { x = y; y = (x + n / x) / 2; }
    x
}

fn edid(path: str) Monitor {
    var result = blank();
    const opened = fs.File.open(path);
    if (opened.is_err()) { ret result; }
    var file = opened.unwrap();
    var data: *u8 = 0;
    unsafe { data = core.malloc(128); }
    if (data == 0) { ret result; }
    var length: usize = 0;
    for (length < 128) {
        var n: isize = -1;
        unsafe { n = file.read(data + length, 128 - length); }
        if (n <= 0) { break; }
        length += n as usize;
    }
    unsafe { if (length == 128 && read_byte(data, 0) == 0 && read_byte(data, 1) == 255 &&
        read_byte(data, 2) == 255 && read_byte(data, 3) == 255 &&
        read_byte(data, 4) == 255 && read_byte(data, 5) == 255 &&
        read_byte(data, 6) == 255 && read_byte(data, 7) == 0) {
        var sum: u64 = 0;
        var i: usize = 0;
        for (i < 128) { sum += read_byte(data, i); i++; }
        if ((sum & 255) == 0) {
            result.name = edid_code(data);
            const clock: u64 = read_byte(data, 54) | (read_byte(data, 55) << 8);
            const hactive: u64 = read_byte(data, 56) | ((read_byte(data, 58) & 240) << 4);
            const hblank: u64 = read_byte(data, 57) | ((read_byte(data, 58) & 15) << 8);
            const vactive: u64 = read_byte(data, 59) | ((read_byte(data, 61) & 240) << 4);
            const vblank: u64 = read_byte(data, 60) | ((read_byte(data, 61) & 15) << 8);
            if (clock > 0 && hactive > 0 && vactive > 0 && hblank > 0 && vblank > 0) {
                result.width = hactive;
                result.height = vactive;
                const total: u64 = (hactive + hblank) * (vactive + vblank);
                result.hz = (clock * 10000 + total / 2) / total;
            }
            var width_mm: u64 = read_byte(data, 66) | ((read_byte(data, 68) & 240) << 4);
            var height_mm: u64 = read_byte(data, 67) | ((read_byte(data, 68) & 15) << 8);
            if (width_mm == 0 || height_mm == 0) {
                width_mm = read_byte(data, 21) * 10;
                height_mm = read_byte(data, 22) * 10;
            }
            if (width_mm > 0 && height_mm > 0) {
                const mm: u64 = integer_sqrt(width_mm * width_mm + height_mm * height_mm);
                result.diagonal = (mm * 10 + 127) / 254;
            }
        }
    }
    }
    unsafe { core.free(data); }
    result
}

fn connector() String {
    @cfg(target_os = "linux") {
        const root: String = os.env("QUAZIFETCH_DRM_ROOT", "/sys/class/drm");
        var entries = dir_entries.names(String.from(root.as_str()));
        var external: String = String.new();
        for (!entries.is_empty()) {
            const entry: String = entries.remove(0);
            const name: str = entry.as_str();
            if (!name.starts_with("card") || !name.contains("-")) { continue; }
            const root_slash: String = text.join(root.as_str(), "/");
            const path: String = text.join(root_slash.as_str(), name);
            const status: String = text.file(text.join(path.as_str(), "/status").as_str());
            if (status.as_str() != "connected") { continue; }
            if (name.contains("-eDP-") || name.contains("-LVDS-") || name.contains("-DSI-")) {
                ret path;
            }
            if (external.is_empty()) { external = path; }
        }
        ret external;
    }
    String.new()
}

fn monitor_path(path: str) Monitor {
    if (path.is_empty()) { ret blank(); }
    const edid_path = text.join(path.as_str(), "/edid");
    var info = edid(edid_path.as_str());
    if (info.width == 0 || info.height == 0) {
        const modes = text.file(text.join(path.as_str(), "/modes").as_str());
        const newline = modes.find("\n");
        var preferred = String.from(modes.as_str());
        if (newline.is_some()) { preferred = text.byte_slice(modes.as_str(), 0, newline.unwrap()); }
        const x = preferred.find("x");
        if (x.is_some()) {
            const separator: usize = x.unwrap();
            const a = text.byte_slice(preferred.as_str(), 0, separator);
            const b = text.byte_slice(preferred.as_str(), separator + 1, preferred.bytes_len());
            const w = a.as_str().parse[u64]();
            const h = b.as_str().parse[u64]();
            if (w.is_ok() && h.is_ok()) {
                info.width = w.unwrap();
                info.height = h.unwrap();
            }
        }
    }
    if (info.name.is_empty()) {
        const n = text.basename(path.as_str());
        const dash = n.find("-");
        if (dash.is_some()) { info.name = text.byte_slice(n.as_str(), dash.unwrap() + 1, n.bytes_len()); }
    }
    info
}

pub fn label() String {
    @cfg(target_os = "netbsd") {
        const resolution = netbsd_framebuffer_from(text.boot_log().as_str());
        const panel = xorg_current(resolution.as_str());
        if (!panel.name.is_empty()) {
            var name = String.from("Display (");
            name = name.push_str(panel.name.as_str());
            ret name.push_str(")");
        }
        ret String.from("Display (Framebuffer)");
    }
    const connector_path = connector();
    const current = monitor_path(connector_path.as_str());
    if (current.name.is_empty()) {
        if (!android.framebuffer().is_empty()) { ret String.from("Display (Framebuffer)"); }
        ret String.from("Display");
    }
    var result: String = String.from("Display (");
    result = result.push_str(current.name.as_str());
    result.push_str(")")
}

pub fn value() String {
    @cfg(target_os = "netbsd") {
        var value = netbsd_framebuffer_from(text.boot_log().as_str());
        const panel = xorg_current(value.as_str());
        if (value.is_empty()) { ret value; }
        if (panel.diagonal > 0) {
            const diagonal = panel.diagonal.to_string();
            value = value.push_str(" in ");
            value = value.push_str(diagonal.as_str());
            value = value.push_str("\"");
        }
        if (panel.hz > 0) {
            const hz = panel.hz.to_string();
            value = value.push_str(", ");
            value = value.push_str(hz.as_str());
            value = value.push_str(" Hz");
        }
        ret value;
    }
    const connector_path = connector();
    var current = monitor_path(connector_path.as_str());
    if (current.width == 0 || current.height == 0) { ret android.framebuffer(); }
    const connector_basename = text.basename(connector_path.as_str());
    const dash = connector_basename.find("-");
    var active = display_live.missing();
    if (dash.is_some()) {
        const connector_name = text.byte_slice(connector_basename.as_str(), dash.unwrap() + 1, connector_basename.bytes_len());
        active = display_live.monitor(connector_name.as_str());
    }
    if (active.width > 0 && active.height > 0) {
        current.width = active.width;
        current.height = active.height;
    }
    if (active.hz > 0) { current.hz = active.hz; }
    const width = current.width.to_string();
    const height = current.height.to_string();
    var value: String = String.from(width.as_str());
    value = value.push_str("x");
    value = value.push_str(height.as_str());
    if (!active.scale.is_empty()) {
        value = value.push_str(" @ ");
        value = value.push_str(active.scale.as_str());
        value = value.push_str("x");
    }
    if (current.diagonal > 0) {
        const diagonal = current.diagonal.to_string();
        value = value.push_str(" in ");
        value = value.push_str(diagonal.as_str());
        value = value.push_str("\"");
    }
    if (current.hz > 0) {
        const refresh = current.hz.to_string();
        value = value.push_str(", ");
        value = value.push_str(refresh.as_str());
        value = value.push_str(" Hz");
    }
    // eDP, LVDS and DSI are internal connector types.
    if (connector_path.contains("-eDP-") || connector_path.contains("-LVDS-") || connector_path.contains("-DSI-")) {
        value = value.push_str(" [Built-in]");
    }
    value
}

@cfg(target_os = "netbsd")
fn netbsd_framebuffer_from(raw: str) String {
    const length = core.strlen(raw);
    var start: usize = 0;
    var i: usize = 0;
    for (i <= length) {
        if (i == length || core.str_byte_at(raw, i) == 10) {
            if (text.contains_range(raw, start, i, "framebuffer at") &&
                text.contains_range(raw, start, i, "size ")) {
                const line = text.byte_slice(raw, start, i);
                const size = line.find("size ");
                if (size.is_some()) {
                    const from = size.unwrap() + 5;
                    const tail = text.byte_slice(line.as_str(), from, line.bytes_len());
                    const comma = tail.find(",");
                    if (comma.is_some()) {
                        const resolution = text.byte_slice(tail.as_str(), 0, comma.unwrap());
                        if (resolution.contains("x")) { ret resolution; }
                    }
                }
            }
            start = i + 1;
        }
        i++;
    }
    String.new()
}



@cfg(target_os = "netbsd")
struct XorgPanel {
    name: String,
    diagonal: u64,
    hz: u64,
}

@cfg(target_os = "netbsd")
fn xorg_empty() XorgPanel {
    XorgPanel { name: String.new(), diagonal: 0, hz: 0 }
}

// Rootless Xorg normally logs under HOME; display managers often use /var/log.
@cfg(target_os = "netbsd")
fn xorg_log() String {
    const xdg = os.env("XDG_DATA_HOME", "");
    if (!xdg.is_empty()) {
        const path = text.join(xdg.as_str(), "/xorg/Xorg.0.log");
        const data = text.file(path.as_str());
        if (!data.is_empty()) { ret data; }
    }
    const home = os.env("HOME", "");
    if (!home.is_empty()) {
        const path = text.join(home.as_str(), "/.local/share/xorg/Xorg.0.log");
        const data = text.file(path.as_str());
        if (!data.is_empty()) { ret data; }
    }
    text.file("/var/log/Xorg.0.log")
}

@cfg(target_os = "netbsd")
fn xorg_number(raw: str) u64 {
    const n = core.strlen(raw);
    var i: usize = 0;
    var result: u64 = 0;
    for (i < n) {
        const b = core.str_byte_at(raw, i);
        if (b < 48 || b > 57) { break; }
        result = result * 10 + (b - 48) as u64;
        i++;
    }
    result
}

@cfg(target_os = "netbsd")
fn xorg_token(raw: str) String {
    const len = core.strlen(raw);
    var i: usize = 0;
    for (i < len) {
        const b = core.str_byte_at(raw, i);
        if (b == 32 || b == 9 || b == 10 || b == 13) { break; }
        i++;
    }
    text.byte_slice(raw, 0, i)
}

@cfg(target_os = "netbsd")
fn xorg_after(raw: str, marker: str) String {
    const at = raw.find(marker);
    if (at.is_none()) { ret String.new(); }
    text.byte_slice(raw, at.unwrap() + core.strlen(marker), core.strlen(raw))
}

@cfg(target_os = "netbsd")
fn xorg_manufacturer(raw: str) String {
    const part = xorg_after(raw, "Manufacturer: ");
    if (part.is_empty()) { ret String.new(); }
    const manufacturer_id = xorg_token(part.as_str());
    if (manufacturer_id.bytes_len() != 3) { ret String.new(); }
    const model = xorg_after(part.as_str(), "Model: ");
    if (model.is_empty()) { ret String.new(); }
    const id = xorg_token(model.as_str());
    if (id.is_empty() || id.bytes_len() > 4) { ret String.new(); }
    var i: usize = 0;
    for (i < id.bytes_len()) {
        const b = core.str_byte_at(id.as_str(), i);
        if (!((b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102))) {
            ret String.new();
        }
        i++;
    }
    // EDID product identifiers are four-digit hexadecimal values.
    var result = manufacturer_id.to_uppercase();
    const upper = id.to_uppercase();
    var pad: usize = id.bytes_len();
    for (pad < 4) { result = result.push_str("0"); pad++; }
    result.push_str(upper.as_str())
}


@cfg(target_os = "netbsd")
fn xorg_hex4(value: u64) String {
    const digits = "0123456789ABCDEF";
    var result = String.new();
    var i: u64 = 4;
    for (i > 0) {
        i--;
        const position = (value >> (i * 4)) & 15;
        const digit = text.byte_slice(digits, position as usize, (position + 1) as usize);
        result = result.push_str(digit.as_str());
    }
    result
}

@cfg(target_os = "netbsd")
fn xorg_edid_vendor(raw: str) String {
    const segment = xorg_after(raw, "EDID vendor \"");
    if (segment.is_empty()) { ret String.new(); }
    const closing = segment.find("\"");
    if (closing.is_none() || closing.unwrap() != 3) { ret String.new(); }
    const vendor = text.byte_slice(segment.as_str(), 0, 3).to_uppercase();
    const id = xorg_after(segment.as_str(), "prod id ");
    if (id.is_empty()) { ret String.new(); }
    const number_id = xorg_number(id.as_str());
    if (number_id > 65535) { ret String.new(); }
    const product = xorg_hex4(number_id);
    vendor.push_str(product.as_str())
}

@cfg(target_os = "netbsd")
fn xorg_diagonal(raw: str) u64 {
    const info = xorg_after(raw, "Max Image Size [cm]:");
    if (info.is_empty()) { ret 0; }
    const line_end = info.find("\n");
    var line = String.from(info.as_str());
    if (line_end.is_some()) { line = text.byte_slice(info.as_str(), 0, line_end.unwrap()); }
    const width = xorg_after(line.as_str(), "horiz.:");
    const height = xorg_after(line.as_str(), "vert.:");
    if (width.is_empty() || height.is_empty()) { ret 0; }
    const w = xorg_number(width.as_str().trim().as_str());
    const h = xorg_number(height.as_str().trim().as_str());
    if (w == 0 || h == 0 || w > 500 || h > 500) { ret 0; }
    // Centimetres to rounded diagonal inches, without floating point.
    const square: u64 = w * w + h * h;
    var root: u64 = square;
    var next: u64 = (root + 1) / 2;
    for (next < root) { root = next; next = (root + square / root) / 2; }
    (root * 100 + 127) / 254
}

@cfg(target_os = "netbsd")
fn xorg_clock_khz(raw: str) u64 {
    const whole = xorg_number(raw);
    if (whole == 0 || whole > 1000) { ret 0; }
    var result = whole * 1000;
    const dot = raw.find(".");
    if (dot.is_none()) { ret result; }
    var place: u64 = 100;
    var i = dot.unwrap() + 1;
    for (i < core.strlen(raw) && place > 0) {
        const b = core.str_byte_at(raw, i);
        if (b < 48 || b > 57) { break; }
        result += (b - 48) as u64 * place;
        place /= 10;
        i++;
    }
    result
}

@cfg(target_os = "netbsd")
fn xorg_refresh(raw: str, resolution: str) u64 {
    if (resolution.is_empty()) { ret 0; }
    var key = String.from("Modeline \"");
    key = key.push_str(resolution);
    key = key.push_str("\"x");
    const data = xorg_after(raw, key.as_str());
    if (data.is_empty()) { ret 0; }
    const end = data.find("\n");
    var line = String.from(data.as_str());
    if (end.is_some()) { line = text.byte_slice(data.as_str(), 0, end.unwrap()); }
    // Xorg normally prints x60.0; some drivers print x0.0 instead.
    const first = text.word(line.as_str(), 0);
    const reported = xorg_number(first.as_str());
    if (reported >= 20 && reported <= 360) { ret reported; }
    const clock = text.word(line.as_str(), 1);
    const htotal = text.word(line.as_str(), 5);
    const vtotal = text.word(line.as_str(), 9);
    const khz = xorg_clock_khz(clock.as_str());
    const h = xorg_number(htotal.as_str());
    const v = xorg_number(vtotal.as_str());
    if (khz == 0 || h == 0 || v == 0 || h > 32768 || v > 32768) { ret 0; }
    const hz = (khz * 1000 + (h * v) / 2) / (h * v);
    if (hz >= 20 && hz <= 360) { ret hz; }
    0
}

@cfg(target_os = "netbsd")
fn xorg_parse(raw: str, resolution: str) XorgPanel {
    if (raw == "") { ret xorg_empty(); }
    // Prefer the built-in connector if the log also lists external monitors.
    var segment = String.from(raw);
    var offset = segment.find("EDID for output eDP");
    if (offset.is_none()) { offset = segment.find("EDID for output LVDS"); }
    if (offset.is_none()) { offset = segment.find("EDID for output DSI"); }
    if (offset.is_some()) {
        segment = text.byte_slice(raw, offset.unwrap(), core.strlen(raw));
    }
    var at = segment.find("Manufacturer: ");
    if (at.is_none()) { at = segment.find("EDID vendor \""); }
    if (at.is_none()) { ret xorg_empty(); }
    const rest = text.byte_slice(segment.as_str(), at.unwrap(), segment.bytes_len());
    const next = rest.find("EDID for output ");
    var block = String.from(rest.as_str());
    if (next.is_some()) { block = text.byte_slice(rest.as_str(), 0, next.unwrap()); }
    var code = xorg_manufacturer(block.as_str());
    if (code.is_empty()) { code = xorg_edid_vendor(block.as_str()); }
    XorgPanel {
        name: code,
        diagonal: xorg_diagonal(block.as_str()),
        hz: xorg_refresh(block.as_str(), resolution),
    }
}

@cfg(target_os = "netbsd")
fn xorg_current(resolution: str) XorgPanel {
    const log = xorg_log();
    xorg_parse(log.as_str(), resolution)
}
