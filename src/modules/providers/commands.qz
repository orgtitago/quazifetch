// Capture command output without going through a shell.
import std.core;
import std.unix;
import std.os;
import std.time;
import text;
import version_cache;

fn close_fd(fd: i32) void { unsafe { unix.close(fd); } }

fn check_executable(path: str) bool {
    var ok: i32 = -1;
    unsafe { ok = unix.access(path, 1); }
    ok == 0
}

pub fn executable(name: str) String {
    @cfg(target_os = "linux") {
        const path: String = os.env("PATH", "");
        var start: usize = 0;
        var i: usize = 0;
        const length: usize = path.bytes_len();
        for (i <= length) {
            if (i == length || core.str_byte_at(path.as_str(), i) == 58) {
                if (i > start) {
                    const dir = text.byte_slice(path.as_str(), start, i);
                    const candidate = text.join(text.join(dir.as_str(), "/").as_str(), name);
                    if (check_executable(candidate.as_str())) { ret candidate; }
                }
                start = i + 1;
            }
            i++;
        }
    }
    String.new()
}

// Monotonic time keeps command deadlines independent of clock adjustments.
pub fn monotonic_ms() u64 {
    @cfg(target_os = "linux") {
        var buffer: *u8 = 0;
        unsafe { buffer = core.malloc(16); }
        if (buffer == 0) { ret 0; }
        var code: i32 = -1;
        unsafe { code = unix.clock_gettime(1, buffer); }
        if (code != 0) { unsafe { core.free(buffer); } ret 0; }
        var seconds: i64 = 0;
        var nanoseconds: i64 = 0;
        unsafe {
            seconds = *(buffer as *i64);
            nanoseconds = *((buffer + 8) as *i64);
            core.free(buffer);
        }
        if (seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000) { ret 0; }
        ret (seconds as u64) * 1000 + (nanoseconds as u64) / 1000000;
    }
    0
}

// Exec directly in the child so the parent's stdout is never redirected.
// The environment is copied before fork and inherited without shell parsing.
fn spawn_piped(path: str, arg1: str, arg2: str, arg3: str,
               input: i32, output: i32) i32 {
    @cfg(target_os = "linux") {
        const capacity: usize = 262144;
        var environment: *u8 = 0;
        unsafe { environment = core.malloc(capacity + 1); }
        if (environment == 0) { ret -1; }
        var envfd: i32 = -1;
        unsafe { envfd = unix.open("/proc/self/environ", 0, 0); }
        if (envfd < 0) {
            unsafe { core.free(environment); }
            ret -1;
        }
        var length: usize = 0;
        for (length < capacity) {
            var count: isize = -1;
            unsafe { count = unix.read(envfd, environment + length, capacity - length); }
            if (count == -4) { continue; }
            if (count < 0) { length = capacity; break; }
            if (count == 0) { break; }
            length += count as usize;
        }
        close_fd(envfd);
        if (length >= capacity) {
            unsafe { core.free(environment); }
            ret -1;
        }
        unsafe { *(environment + length) = 0; }
        var entries: usize = 0;
        var scan: usize = 0;
        for (scan < length) {
            var c: u8 = 0;
            unsafe { c = *(environment + scan); }
            if (c == 0) { entries++; }
            scan++;
        }
        var pointers: *u8 = 0;
        var arguments: *u8 = 0;
        unsafe {
            pointers = core.malloc((entries + 2) * 8);
            arguments = core.malloc(5 * 8);
        }
        if (pointers == 0 || arguments == 0) {
            unsafe {
                core.free(environment);
                if (pointers != 0) { core.free(pointers); }
                if (arguments != 0) { core.free(arguments); }
            }
            ret -1;
        }
        entries = 0;
        var offset: usize = 0;
        for (offset < length) {
            unsafe {
                *((pointers + entries * 8) as **u8) = environment + offset;
            }
            entries++;
            for (offset < length) {
                var c: u8 = 0;
                unsafe { c = *(environment + offset); }
                offset++;
                if (c == 0) { break; }
            }
        }
        unsafe {
            *((pointers + entries * 8) as **u8) = 0;
            *((arguments + 0) as **u8) = core.str_as_ptr(path);
        }
        var n: usize = 1;
        if (arg1 != "") {
            unsafe { *((arguments + n * 8) as **u8) = core.str_as_ptr(arg1); }
            n++;
        }
        if (arg2 != "") {
            unsafe { *((arguments + n * 8) as **u8) = core.str_as_ptr(arg2); }
            n++;
        }
        if (arg3 != "") {
            unsafe { *((arguments + n * 8) as **u8) = core.str_as_ptr(arg3); }
            n++;
        }
        unsafe { *((arguments + n * 8) as **u8) = 0; }
        var pid: i32 = -1;
        unsafe { pid = unix.fork(); }
        if (pid == 0) {
            unsafe {
                close_fd(input);
                if (unix.dup2(output, 1) < 0) { unix.exit(127); }
                close_fd(output);
                const nullfd: i32 = unix.open("/dev/null", 1, 0);
                if (nullfd >= 0) {
                    unix.dup2(nullfd, 2);
                    close_fd(nullfd);
                }
                unix.execve(path, arguments, pointers);
                unix.exit(127);
            }
        }
        unsafe { core.free(environment); core.free(pointers); core.free(arguments); }
        ret pid;
    }
    -1
}

fn finish_child(pid: i32, terminate: bool) bool {
    @cfg(target_os = "linux") {
        if (terminate) { unsafe { unix.kill(pid, 9); } }
        var status: u32 = 0;
        var observed: i32 = -1;
        for (true) {
            unsafe { observed = unix.wait4(pid, &status, 0, 0); }
            if (observed != -4) { break; }
        }
        ret observed == pid && (status & 127) == 0 && ((status >> 8) & 255) == 0;
    }
    false
}

// Bound both output size and elapsed time, even if stdout closes early.
pub fn capture_timeout(program: str, arg1: str, arg2: str, arg3: str, timeout_ms: u64) String {
    @cfg(target_os = "linux") {
        if (timeout_ms == 0) { ret String.new(); }
        const path = executable(program);
        if (path.is_empty()) { ret String.new(); }
        var fds: *u8 = 0;
        unsafe { fds = core.malloc(8); }
        if (fds == 0) { ret String.new(); }
        var opened: i32 = -1;
        unsafe { opened = unix.pipe2(fds, 524288); }
        if (opened < 0) {
            unsafe { core.free(fds); }
            ret String.new();
        }
        var input: i32 = -1;
        var output: i32 = -1;
        unsafe {
            input = *(fds as *i32);
            output = *((fds + 4) as *i32);
            core.free(fds);
        }
        const started = monotonic_ms();
        if (started == 0) { close_fd(input); close_fd(output); ret String.new(); }
        const pid = spawn_piped(path.as_str(), arg1, arg2, arg3, input, output);
        close_fd(output);
        if (pid <= 0) { close_fd(input); ret String.new(); }
        const max_output: usize = 2097152;
        var buffer: *u8 = 0;
        var ready: *u8 = 0;
        unsafe {
            buffer = core.malloc(max_output + 1);
            ready = core.malloc(8);
        }
        if (buffer == 0 || ready == 0) {
            if (buffer != 0) { unsafe { core.free(buffer); } }
            if (ready != 0) { unsafe { core.free(ready); } }
            close_fd(input);
            finish_child(pid, true);
            ret String.new();
        }
        unsafe {
            *(ready as *i32) = input;
            *((ready + 4) as *i32) = 1;
        }
        var used: usize = 0;
        var finished: bool = false;
        var bad: bool = false;
        for (!finished && used < max_output) {
            const now = monotonic_ms();
            if (now < started || now - started >= timeout_ms) { bad = true; break; }
            const remaining = timeout_ms - (now - started);
            const delay: i32 = if (remaining < 100) { remaining as i32 } else { 100 };
            var polled: i32 = -1;
            unsafe { polled = unix.poll(ready, 1, delay); }
            if (polled == -4) { continue; }
            if (polled < 0) { bad = true; break; }
            if (polled == 0) { continue; }
            var n: isize = -1;
            unsafe { n = unix.read(input, buffer + used, max_output - used); }
            if (n == -4) { continue; }
            if (n < 0) { bad = true; break; }
            if (n == 0) { finished = true; break; }
            used += n as usize;
        }
        if (used == max_output) { bad = true; }
        close_fd(input);
        unsafe { core.free(ready); }
        if (bad || !finished) {
            finish_child(pid, true);
            unsafe { core.free(buffer); }
            ret String.new();
        }
        var success: bool = false;
        var complete: bool = false;
        for (!complete) {
            var status: u32 = 0;
            var observed: i32 = -1;
            unsafe { observed = unix.wait4(pid, &status, 1, 0); }
            if (observed == pid) {
                success = (status & 127) == 0 && ((status >> 8) & 255) == 0;
                complete = true;
                break;
            }
            if (observed < 0 && observed != -4) { break; }
            const now = monotonic_ms();
            if (now < started || now - started >= timeout_ms) { break; }
            time.sleep(time.Duration.from_milliseconds(10));
        }
        if (!complete) { finish_child(pid, true); }
        var value = String.new();
        if (success && used > 0) {
            unsafe {
                *(buffer + used) = 0;
                value = String.from(core.str_from_ptr(buffer));
            }
        }
        unsafe { core.free(buffer); }
        ret value;
    }
    String.new()
}

pub fn capture(program: str, arg1: str, arg2: str, arg3: str) String {
    capture_timeout(program, arg1, arg2, arg3, 2500)
}

// Accept dotted versions from common --version output formats.
pub fn parse_version(output: str) String {
    const length: usize = output.bytes_len();
    var i: usize = 0;
    for (i + 2 < length) {
        const a: u8 = core.str_byte_at(output, i);
        if (a < 48 || a > 57) { i++; continue; }
        // Do not match a version embedded in an identifier.
        if (i > 0) {
            const prev: u8 = core.str_byte_at(output, i - 1);
            if ((prev >= 48 && prev <= 57) || (prev >= 65 && prev <= 90) ||
                (prev >= 97 && prev <= 122)) { i++; continue; }
        }
        var j: usize = i;
        var saw_dot: bool = false;
        for (j < length) {
            const c: u8 = core.str_byte_at(output, j);
            if (c >= 48 && c <= 57) { j++; continue; }
            if (c == 46 && j > i && j + 1 < length) {
                const next: u8 = core.str_byte_at(output, j + 1);
                if (next >= 48 && next <= 57) { saw_dot = true; j++; continue; }
            }
            break;
        }
        if (saw_dot) { ret text.byte_slice(output, i, j); }
        i++;
    }
    String.new()
}

pub fn version(program: str, argument: str) String {
    const path = executable(program);
    if (path.is_empty()) { ret String.new(); }
    const cached = version_cache.load(program, path.as_str());
    if (!cached.is_empty()) { ret cached; }
    const content = capture(program, argument, "", "");
    if (content.is_empty()) { ret String.new(); }
    var parsed: String = String.new();
    const tag = content.find("Tag: v");
    if (tag.is_some()) {
        const suffix = text.byte_slice(content.as_str(), tag.unwrap() + 6, content.bytes_len());
        parsed = parse_version(suffix.as_str());
    }
    if (parsed.is_empty()) { parsed = parse_version(content.as_str()); }
    if (!parsed.is_empty()) { version_cache.save(program, path.as_str(), parsed.as_str()); }
    parsed
}
