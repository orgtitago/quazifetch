import std.os;

pub fn protocol() String {
    const session_type: String = os.env("XDG_SESSION_TYPE", "");
    if (session_type.as_str() == "wayland") { ret String.from("Wayland"); }
    if (session_type.as_str() == "x11") { ret String.from("X11"); }
    if (!os.env("WAYLAND_DISPLAY", "").is_empty()) { ret String.from("Wayland"); }
    if (!os.env("DISPLAY", "").is_empty()) { ret String.from("X11"); }
    String.new()
}

pub fn compose(name: str, version: str, with_protocol: bool) String {
    if (name == "") { ret String.new(); }
    var output = String.from(name);
    if (version != "") {
        output = output.push_str(" ");
        output = output.push_str(version);
    }
    if (with_protocol) {
        const p = protocol();
        if (!p.is_empty()) {
            output = output.push_str(" (");
            output = output.push_str(p.as_str());
            output = output.push_str(")");
        }
    }
    output
}

pub fn value() String {
    @cfg(target_os = "windows") { ret os.env("SESSIONNAME", ""); }
    protocol()
}
